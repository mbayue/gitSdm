# GitHub API (optional, increases rate limits for public repos)
GITHUB_TOKEN=

# AI provider: gemini | openai | anthropic | mock
AI_PROVIDER=mock
# Optional separate provider for semantic search: openai, gemini, or mock.
# EMBEDDING_PROVIDER=openai
# Independent embedding credentials and endpoint (recommended).
# Legacy OPENAI_/GEMINI_ settings are used when these are absent.
# EMBEDDING_API_KEY=
# EMBEDDING_API_BASE=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# OpenAI-compatible example: OPENAI_API_BASE=https://api.featherless.ai/v1
# OPENAI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# EMBEDDING_DIMENSIONS=4096

# AI API Key (mandatory)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model overrides (optional)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_VERSION=v1alpha
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Provider API base URL overrides (optional)
OPENAI_API_BASE=
ANTHROPIC_API_BASE=

# Embedding overrides (optional)
OPENAI_EMBEDDING_MODEL=openrouter/openai/text-embedding-3-large
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=3072

# Cache key hashing secret (optional, set a stable random value in production)
# Required in shared mode (including when Redis is configured). Use a random secret.
# Local mode generates a process-only secret when this is blank.
TOKEN_CACHE_HASH_SECRET=

# Production server binding (optional)
HOST=0.0.0.0
PORT=3000

# Daily embedding input budget (300 MB; non-refundable reservation per attempt).
# In the default local mode this budget is PER-PROCESS: each instance enforces its own 300 MB.
# To share one budget across instances, use shared-mode rate limiting:
#   RATE_LIMIT_MODE=shared plus UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN.
SERVER_EMBEDDING_DAILY_BYTES=300000000

API_REQUESTS_PER_MINUTE=600

SERVER_AI_DAILY_CALLS=500

API_REQUESTS_PER_IP_PER_MINUTE=120
