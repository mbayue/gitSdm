# GitHub API (optional, increases rate limits for public repos)
GITHUB_TOKEN=

# AI provider: gemini | openai | anthropic | edgeone | mock
AI_PROVIDER=mock
# Optional separate provider for semantic search: openai, gemini, or mock.
# EMBEDDING_PROVIDER=openai
# OpenAI-compatible example: OPENAI_API_BASE=https://api.featherless.ai/v1
# OPENAI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B, EMBEDDING_DIMENSIONS=4096

# AI API Key (mandatory)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EDGEONE_API_KEY=

# Model overrides (optional)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_VERSION=v1alpha
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
EDGEONE_MODEL=@makers/deepseek-v4-flash

# Provider API base URL overrides (optional)
OPENAI_API_BASE=
ANTHROPIC_API_BASE=
EDGEONE_API_BASE=https://ai-gateway.edgeone.link/v1

# Embedding overrides (optional)
OPENAI_EMBEDDING_MODEL=openrouter/openai/text-embedding-3-large
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=3072

# Cache key hashing secret (optional, set a stable random value in production)
# Required in shared mode (including when Redis is configured). Use a random secret.
# Local mode generates a process-only secret when this is blank.
TOKEN_CACHE_HASH_SECRET=

# Production server binding (optional)
HOST=0.0.0.0
PORT=3000

# Daily shared embedding input budget (300 MB; non-refundable reservation per attempt).
SERVER_EMBEDDING_DAILY_BYTES=300000000

API_REQUESTS_PER_MINUTE=600

SERVER_AI_DAILY_CALLS=500

API_REQUESTS_PER_IP_PER_MINUTE=120
